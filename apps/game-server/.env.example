# Port for Colyseus server (Railway and Render provide this automatically)
PORT=2567
NODE_ENV=production

# Optional: PostgreSQL Database URL (e.g. Neon.tech, Supabase, or Railway Postgres)
# If omitted, matches run 100% in-memory and skip career stats archiving.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

