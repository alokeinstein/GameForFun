# The URL of your deployed Colyseus Game Server (e.g. on Railway or Render)
# Locally, it defaults to ws://localhost:2567 if left unset
# For production (e.g. on Vercel), set this to your Railway/Render server URL:
# Example: NEXT_PUBLIC_GAME_SERVER_URL=wss://your-game-server.up.railway.app
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

