datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MAFIA
  CITIZEN
}

enum MatchResult {
  MAFIA_VICTORY
  CITIZEN_VICTORY
  ABANDONED
}

enum EliminationCause {
  NIGHT_KILL
  VOTED_OUT
  DISCONNECTED
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String?         @unique
  passwordHash  String?
  avatarConfig  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  hostedGames   GameSession[]   @relation("HostedGames")
  gameHistory   GamePlayer[]
  statistics    PlayerStats?
}

model GameSession {
  id              String         @id @default(uuid())
  roomCode        String         @unique
  hostUserId      String
  host            User           @relation("HostedGames", fields: [hostUserId], references: [id])
  status          String         // LOBBY, IN_PROGRESS, COMPLETED, CANCELLED
  winner          MatchResult?
  configJson      String         // Stored settings: timers, mafia %, revote rules
  playerCount     Int
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime       @default(now())

  players         GamePlayer[]
  events          GameEvent[]

  @@index([roomCode])
}

model GamePlayer {
  id               String            @id @default(uuid())
  gameSessionId    String
  gameSession      GameSession       @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  displayName      String
  role             Role
  survived         Boolean           @default(false)
  eliminationCause EliminationCause?
  eliminatedRound  Int?
  joinedAt         DateTime          @default(now())

  @@index([gameSessionId])
  @@index([userId])
}

model GameEvent {
  id              String       @id @default(uuid())
  gameSessionId   String
  gameSession     GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  roundNumber     Int
  eventType       String
  publicDetails   String
  createdAt       DateTime     @default(now())

  @@index([gameSessionId, roundNumber])
}

model PlayerStats {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamesPlayed     Int          @default(0)
  gamesWon        Int          @default(0)
  mafiaWins       Int          @default(0)
  citizenWins     Int          @default(0)
  timesEliminated Int          @default(0)
  timesSurvived   Int          @default(0)
}
